# Setuptools build artifacts
build/
dist/
**/*.egg-info/

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo

# Development environments — local virtualenvs and tooling dirs are never needed in the image.
.venv/
venv/
.devenv/
.direnv/

# Local config — secrets and editor settings must never be baked into the image.
.env
.gitignore

# Test and coverage artifacts
.pytest_cache/
.coverage

# Version control
.git/

# Docker configuration — the Dockerfile and compose files are not part of the application.
.docker/

# Large output directories produced by simulation runs
results/
images/
